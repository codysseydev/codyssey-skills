{
  "type": "object",
  "required": ["family", "title", "intro", "sections"],
  "additionalProperties": false,
  "properties": {
    "family": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string", "pattern": "\\S" },
    "intro": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["heading", "intro", "list", "entries"],
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string", "pattern": "\\S" },
        "intro": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
        "list": { "enum": ["bullet", "numbered"] },
        "entries": {
          "type": "array",
          "items": { "oneOf": [{ "$ref": "#/$defs/entry" }, { "$ref": "#/$defs/note" }] }
        }
      }
    },
    "note": {
      "type": "object",
      "required": ["note"],
      "additionalProperties": false,
      "properties": {
        "note": { "type": "string", "pattern": "\\S" }
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "family", "scope", "keyword", "rule", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
        "family": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "scope": {
          "enum": ["language-agnostic", "php-core", "laravel", "symfony", "filament", "nextjs"]
        },
        "keyword": { "enum": ["MUST", "MUST NOT", "SHOULD", "SHOULD NOT", "MAY"] },
        "rule": { "type": "string", "pattern": "\\S" },
        "items": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } },
        "why": { "type": "string", "pattern": "\\S" },
        "applies_to": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } },
        "allowed_in": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } },
        "detect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } },
            "signals": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tool", "coverage", "status"],
            "additionalProperties": false,
            "properties": {
              "tool": { "type": "string", "pattern": "\\S" },
              "coverage": { "type": "string", "pattern": "\\S" },
              "status": { "enum": ["draft", "verified"] }
            }
          }
        },
        "examples": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bad": { "type": "string", "pattern": "\\S" },
            "good": { "type": "string", "pattern": "\\S" }
          }
        },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } },
        "lane_note": { "type": "string", "pattern": "\\S" },
        "duplicate_of": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
        "status": { "enum": ["active", "candidate", "deprecated"] }
      }
    }
  }
}
